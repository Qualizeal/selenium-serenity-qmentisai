# Environment Configuration Template
# Copy this to env/.env.dev or env/.env.qa and fill in your credentials
# NEVER commit env/.env.dev or env/.env.qa files to version control

# Application Configuration
TEST_BASE_URL=https://your-app-url.com/app/security/login

# Test Credentials - REPLACE WITH YOUR ACTUAL CREDENTIALS
TEST_USERNAME=your_username@test.com
TEST_PASSWORD=YourPassword123!

# Browser Configuration
BROWSER_TYPE=chrome
FORK_COUNT=1
